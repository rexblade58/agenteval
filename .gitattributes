# Ensure consistent line endings across all platforms
* text=auto

# YAML and shell scripts must use LF (GitHub Actions, CI)
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.svg text eol=lf
